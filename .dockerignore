# Dependencies — installed fresh inside the image via `npm install`; never copy the
# host's (wrong-platform binaries would clobber the image's own install).
node_modules/

# Runtime data & secrets — mounted at runtime (-v ...:/fgc/data). Must never be baked
# into the image, especially data/*.env which holds credentials.
data/
*.env

# Version control & CI
.git/
.gitignore
.gitattributes
.github/

# Editor / IDE
.idea/
.vscode/

# Docker build files — not needed inside the image
Dockerfile
.dockerignore
docker-compose.yml

# Dev-only config & docs — not used at runtime
eslint.config.js
jsconfig.json
sonar-project.properties
test/
*.md
